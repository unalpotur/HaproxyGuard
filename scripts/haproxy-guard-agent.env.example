# Copy to /etc/haproxy-guard-agent.env and fill in the values from enrollment.
# Enroll a node in the Guard UI (Cluster tab) or via the API; it returns a
# node id and a one-time token.

GUARD_URL=http://guard.example.com:8000
NODE_ID=node_xxxxxxxxxx
NODE_TOKEN=replace-with-the-token-shown-once

# ── Manage mode ─────────────────────────────────────────────────────────
# How HAProxy is controlled on this host:
#   systemd  — HAProxy runs as a systemd service (default)
#   docker   — HAProxy runs as a Docker container
MANAGE_MODE=systemd

# ── systemd mode settings ───────────────────────────────────────────────
# HAPROXY_CFG=/etc/haproxy/haproxy.cfg
# HAPROXY_BIN=haproxy
# RELOAD_CMD=systemctl reload haproxy

# ── Docker mode settings ────────────────────────────────────────────────
# HAPROXY_CFG=/etc/haproxy/haproxy.cfg
# CONTAINER_NAME=haproxy-prod
# CONTAINER_CFG_PATH=/usr/local/etc/haproxy/haproxy.cfg

# ── Common ──────────────────────────────────────────────────────────────
# INTERVAL=10
# AGENT_VERSION=2.0.0
