# ── Required ────────────────────────────────────────────────────────────
# Database connection (PostgreSQL in Docker, SQLite for local dev)
# DATABASE_URL=postgresql+asyncpg://guard:guard@localhost:5432/haproxyguard

# ── Optional ────────────────────────────────────────────────────────────
# AI assistant — Anthropic Claude API key (heuristic-only mode if unset)
# ANTHROPIC_API_KEY=sk-ant-...

# Bootstrap an admin principal and enable RBAC enforcing mode
# HG_ADMIN_KEY=your-secure-admin-key

# Live dashboard — stats socket address (e.g. 127.0.0.1:9999)
# HAPROXY_STATS_ADDR=127.0.0.1:9999

# Metrics collection interval (seconds, default: 2)
# HG_METRICS_INTERVAL=2

# ── Port overrides (defaults shown) ─────────────────────────────────────
# HG_WEB_PORT=8080
# HG_API_PORT=8000

# ── Production HAProxy container ports (Docker mode) ────────────────────
# HG_HAPROXY_HTTP=80
# HG_HAPROXY_HTTPS=443
# HG_HAPROXY_STATS=9999

# ── Dev / Debug ─────────────────────────────────────────────────────────
# Enable SQL query logging
# HG_DB_ECHO=1

# Path to local HAProxy config for /api/local-config endpoint
# HG_LOCAL_CONFIG=/etc/haproxy/haproxy.cfg
